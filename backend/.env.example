# Copy to backend/.env. Never commit the real .env or the service-account key.

# ---------------------------------------------------------------- required
# Path to the GCP service-account key. Leave unset on GCP to use Application Default Credentials.
GOOGLE_APPLICATION_CREDENTIALS=D:\ticm-qa.json
GCP_PROJECT=ticm-qa
GCP_LOCATION=global
GEMINI_MODEL=gemini-2.5-flash

# ---------------------------------------------------------------- frontend integration
# Where headless Chromium opens /print/{id} for PDF export (the frontend's public URL).
FRONTEND_URL=http://localhost:5173
# Browser origins allowed to call this API directly (comma-separated). Not needed behind a reverse proxy.
CORS_ORIGINS=http://localhost:5173
# Optional single-process mode: serve a built frontend from this API.
# FRONTEND_DIST_DIR=../frontend/dist

# ---------------------------------------------------------------- optional services (each degrades gracefully)
# Stock photos: set ONE to enable photo search and real photos on image slides.
# UNSPLASH_ACCESS_KEY=
# PEXELS_API_KEY=
# Image generation on Vertex (auto-detected at startup).
# IMAGE_MODEL=imagen-4.0-fast-generate-001     # or gemini-2.5-flash-image
# IMAGE_LOCATION=us-central1
# ENABLE_IMAGE_GENERATION=true
# "Web research" toggle (Google Search grounding, auto-detected).
# ENABLE_GROUNDING=true

# ---------------------------------------------------------------- tuning
# MAX_CONCURRENT_LLM=16
# SLIDE_CONCURRENCY=6
# DATA_DIR=data                 # SQLite DB + cached images (relative to the working directory)
# MAX_VERSIONS_PER_DECK=50
