# Copy to frontend/.env (or .env.local). Vite inlines VITE_* values at build time.

# Base URL of the Aira API. Leave empty when the API is reachable on the same origin
# (Vite dev proxy below, or the nginx reverse proxy in the Docker image).
# Set it only when the frontend and API are hosted on different domains, and add this
# frontend's origin to CORS_ORIGINS in backend/.env.
VITE_API_BASE_URL=

# Dev server only: where `npm run dev` forwards /api and /media.
VITE_DEV_API_PROXY=http://localhost:8000
