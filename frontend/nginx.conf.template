# Static frontend + reverse proxy to the API (one origin for the browser: no CORS needed).
# ${BACKEND_URL} is substituted at container start (nginx official image envsubst).
server {
  listen 80;
  server_name _;
  root /usr/share/nginx/html;
  client_max_body_size 16m;

  location /api/ {
    proxy_pass ${BACKEND_URL};
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    # Server-sent events (slide streaming): no buffering, long reads
    proxy_buffering off;
    proxy_cache off;
    proxy_read_timeout 600s;
  }

  location /media/ {
    proxy_pass ${BACKEND_URL};
    proxy_set_header Host $host;
    expires 30d;
  }

  location /assets/ {
    try_files $uri =404;
    expires 1y;
    add_header Cache-Control "public, immutable";
  }

  location / {
    try_files $uri /index.html;
  }
}
